# BIM Agent Configuration
# Copy this file to .env and fill in your values

# ============================================
# Autodesk Platform Services (APS) Configuration
# ============================================

# Get these from https://aps.autodesk.com/myapps
APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here

# Generate via OAuth flow or use existing token
# Token format: 3-legged OAuth token with data:read scope
APS_ACCESS_TOKEN=your_access_token_here

# Exchange ID from Revit Connector publish
# Format: urn:adsk.wipprod:dm.lineage:abc123...
APS_EXCHANGE_ID=your_exchange_id_here

# ============================================
# BIM Pipeline Paths
# ============================================

# Where to save fetched elements (JSONL format)
BIM_FLAT_JSONL=./out/elements.jsonl

# CSV and Markdown summary outputs
BIM_CSV=./out/elements.csv
BIM_MD=./out/elements.md

# Vector database directory for RAG
VECTOR_DB_DIR=./vectordb

# ============================================
# OpenAI Configuration
# ============================================

# Required for embeddings and PRP agent
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model for RAG
# Options: text-embedding-3-small, text-embedding-3-large
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Chat model for BIM agent
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_CHAT_MODEL=gpt-4o-mini

# ============================================
# Supabase Configuration (for Archon integration)
# ============================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# Optional: Testing
# ============================================

# Test query to run after indexing (optional)
# BIM_TEST_QUERY="How many doors on Level 1?"

# ============================================
# Optional: Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
